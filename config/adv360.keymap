// &kp ESCAPE        &kp Q     &kp D          &kp R         &kp W    &kp B                  &tog 1                                                                           &none            &kp J    &kp F    &kp U      &kp P    &kp SEMICOLON   &kp BACKSPACE
//    &lt 2 TAB      &kp A     &kp S          &kp H         &hh 8 T  &kp G      &kp C_VOLUME_DOWN  &kp C_PLAY_PAUSE  &kp PRINTSCREEN       &kp C_PREV   &kp C_NEXT           &kp C_VOLUME_UP  &kp Y    &kp N    &kp E      &kp O    &hh 6 I         &kp SQT
// &kp LSHIFT &mt LSHIFT Z     &kp X          &kp M         &kp C    &kp V                                                     &mo 3       &kp RS(LA(LG(M)))                                  &kp K    &kp L    &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH  &mt RIGHT_SHIFT SLASH
//    &tog 0  &kp GRAVE  &kp CAPS  &sk RIGHT_ALT  &sk LEFT_GUI                 &kp ENTER           &kp ESC   &kp RS(LG(SPACE))          &kp DELETE   &kp BACKSPACE  &kp SPACE                 &sk RIGHT_CONTROL  &sk RGUI   &kp DOT  &kp SLASH        &none
//            >;
