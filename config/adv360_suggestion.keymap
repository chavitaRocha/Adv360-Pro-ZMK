#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/*
 * 4-LAYER OPTIMIZED KEYMAP SUGGESTION
 *
 * Layer 0: Base (QWERTY with home row mods)
 * Layer 1: Numbers + Navigation + Media
 * Layer 2: Symbols (consolidated from original L6-L8)
 * Layer 3: Function Keys + System Controls
 *
 * Home row mods: Fully preserved from original config
 * Clean 4-layer design without alternative layouts
 */

&lt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    quick_tap_ms = <80>;
};

&sl {
    release-after-ms = <2000>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Quick Esc combo (keep from original)
        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
        };

        // Quote combo (keep from original)
        combo_sqt {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&kp SQT>;
        };
    };

    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"
        #ifndef VERSION_MACRO
        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };
        #endif

        // Home row mods (preserved from original)
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hh: homerow_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            quick_tap_ms = <120>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        ht: homerow_layer_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LAYER_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        hl: homerow_low_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LOW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <120>;
            quick_tap_ms = <120>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        pinky: pinky_low_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "PINKY_LOW_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <210>;
            quick_tap_ms = <180>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // LAYER 0: BASE (QWERTY + Home Row Mods)
        // ============================================================
        default_layer {
            display-name = "Base";
            bindings = <
    &kp ESC       &kp N1           &kp N2         &kp N3        &kp N4      &kp N5        &mo 3                                                                           &mo 3            &kp N6      &kp N7        &kp N8       &kp N9          &kp N0           &kp BACKSPACE
    &kp TAB       &kp Q            &kp W          &kp E         &kp R       &kp T         &mo 1                                                                           &mo 2            &kp Y       &kp U         &kp I        &kp O           &kp P            &kp BACKSPACE
    &lt 1 TAB     &pinky RALT A    &hm LCTRL S    &hm LGUI D    &hh 2 F     &kp G         &kp C_VOL_DN    &kp C_PP       &kp PSCRN        &kp C_PREV    &kp C_NEXT    &kp C_VOL_UP     &kp H       &ht 2 J       &hl LGUI K   &hm LCTRL L     &hh 2 SEMICOLON  &kp SQT
    &kp LSHIFT    &mt LSHIFT Z     &kp X          &kp C         &kp V       &kp B                                        &mo 3            &trans                                      &kp N       &kp M         &kp COMMA    &kp DOT         &mt RSHIFT SLASH &kp RSHIFT
    &mo 1         &kp GRAVE        &kp CAPS       &sk LALT      &sk LGUI                  &kp ENTER       &kp ESC        &kp LG(SPACE)    &kp DELETE    &kp BACKSPACE &kp SPACE                    &sk RCTRL     &sk RGUI     &mo 2           &mo 3            &trans
            >;
        };

        // ============================================================
        // LAYER 1: NUMBERS + NAVIGATION (vim hjkl) + MEDIA
        // ============================================================
        layer_numbers_nav {
            display-name = "Num+Nav";
            bindings = <
    &kp EQUAL     &kp N1           &kp N2         &kp N3        &kp N4      &kp N5        &trans                                                                          &trans           &kp N6      &kp KP_N7     &kp KP_N8    &kp KP_N9       &kp KP_DIVIDE    &kp KP_MULTIPLY
    &trans        &trans           &trans         &trans        &trans      &trans        &trans                                                                          &trans           &trans      &kp KP_N7     &kp KP_N8    &kp KP_N9       &kp KP_MINUS     &kp MINUS
    &trans        &kp HOME         &kp PG_DN      &kp PG_UP     &kp END     &trans        &trans          &trans         &trans           &trans        &trans        &trans           &kp LEFT    &kp DOWN      &kp UP       &kp RIGHT       &kp KP_PLUS      &kp EQUAL
    &trans        &trans           &trans         &trans        &trans      &trans                                       &trans           &trans                                       &trans      &kp KP_N1     &kp KP_N2    &kp KP_N3       &kp KP_ENTER     &trans
    &trans        &trans           &trans         &trans        &trans                    &trans          &trans         &trans           &trans        &trans        &kp KP_N0                    &kp KP_N0     &kp KP_DOT   &trans          &trans           &trans
            >;
        };

        // ============================================================
        // LAYER 2: SYMBOLS (Consolidated from L6, L7, L8)
        // ============================================================
        layer_symbols {
            display-name = "Symbols";
            bindings = <
    &trans        &kp EXCL         &kp AT         &kp HASH      &kp DLLR    &kp PRCNT     &trans                                                                          &trans           &kp CARET   &kp AMPS      &kp ASTRK    &kp LPAR        &kp RPAR         &kp BSPC
    &trans        &kp EXCL         &kp AT         &kp LPAR      &kp RPAR    &kp PIPE      &trans                                                                          &trans           &kp TILDE   &kp UNDER     &kp PLUS     &kp LBRC        &kp RBRC         &kp BSLH
    &trans        &kp HASH         &kp DLLR       &kp LBRC      &kp RBRC    &kp GRAVE     &trans          &trans         &trans           &trans        &trans        &trans           &kp LEFT    &kp DOWN      &kp UP       &kp RIGHT       &kp COLON        &kp DQT
    &trans        &kp PRCNT        &kp CARET      &kp LBKT      &kp RBKT    &kp TILDE                                    &trans           &trans                                       &kp MINUS   &kp EQUAL     &kp LT       &kp GT          &kp QMARK        &trans
    &trans        &trans           &trans         &trans        &trans                    &trans          &trans         &trans           &trans        &trans        &trans                       &trans        &trans       &trans          &trans           &trans
            >;
        };

        // ============================================================
        // LAYER 3: FUNCTION KEYS + SYSTEM + ADVANCED WM
        // ============================================================
        layer_function_system {
            display-name = "Fn+Sys";
            bindings = <
    &kp F1        &kp F2           &kp F3         &kp F4        &kp F5      &kp F6        &trans                                                                          &trans           &kp F7      &kp F8        &kp F9       &kp F10         &kp F11          &kp F12
    &none         &bt BT_SEL 0     &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4 &bootloader                                                                     &bootloader      &none       &kp LG(N7)    &kp LG(N8)   &kp LG(N9)      &none            &none
    &none         &none            &none          &none         &bt BT_CLR  &none         &none           &none          &none            &bt BT_CLR    &none         &rgb_ug RGB_MEFS_CMD 5 &kp LA(LG(F)) &kp LG(N4)  &kp LG(N5)   &kp LG(N6)      &none            &none
    &none         &none            &none          &none         &none       &none                                        &trans           &trans                                       &kp LG(N1)  &kp LG(N2)    &kp LG(N3)   &none           &none            &none
    &none         &none            &none          &none         &none                     &none           &none          &none            &bl BL_TOG    &rgb_ug RGB_TOG &trans                      &bl BL_INC    &bl BL_DEC   &trans          &trans           &none
            >;
        };

        // Reserved layers for future use
        extra1 {
            display-name = "Extra1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra2";
            status = "reserved";
        };

        extra3 {
            display-name = "Extra3";
            status = "reserved";
        };

        extra4 {
            display-name = "Extra4";
            status = "reserved";
        };
    };
};

/*
 * ============================================================
 * LAYER ORGANIZATION SUMMARY
 * ============================================================
 *
 * LAYER 0 - BASE (QWERTY)
 * - Full QWERTY layout with home row mods
 * - Pinky: RALT on A
 * - Home row: LCTRL (S), LGUI (D), Layer 2 (F)
 * - Right home: Layer 2 (J), LGUI (K), LCTRL (L), Layer 2 (;)
 * - Thumb cluster: Enter, Esc, Cmd+Space, Delete, Backspace, Space
 * - Top corners: &mo 3 for quick function layer access
 *
 * LAYER 1 - NUMBERS + NAVIGATION
 * - Right side vim navigation: H=left, J=down, K=up, L=right
 * - Left side: Home, PgDn, PgUp, End (home row position)
 * - Right side: Numpad layout (7,8,9 / 4,5,6 / 1,2,3 / 0,.)
 * - Math operators: +, -, *, /, =
 * - Combines functionality from original L2 (keypad) + L5 (WM navigation)
 *
 * LAYER 2 - SYMBOLS
 * - Left side: !, @, #, $, %, ^, &, *, (, )
 * - Right side: ~, _, +, {, }, \, -, =, <, >, ?
 * - Common symbols: Brackets [], Braces {}, Parens ()
 * - Quotes and special characters
 * - Consolidated from original L6, L7, L8
 *
 * LAYER 3 - FUNCTION + SYSTEM
 * - Top row: F1-F12 function keys
 * - Bluetooth: BT_SEL 0-4, BT_CLR
 * - System: Bootloader access
 * - RGB/Backlight: Controls for customization
 * - Window Manager: Cmd+N1-N9 shortcuts, Alt+Cmd+F
 * - Combines original L3 (function) + L4 (system) + advanced L5 (WM)
 *
 * ============================================================
 * KEY IMPROVEMENTS
 * ============================================================
 *
 * 1. REDUCED COGNITIVE LOAD
 *    - 4 primary layers instead of 8 (50% reduction)
 *    - Clearer mental model: Base � Numbers � Symbols � System
 *    - Less layer switching during normal use
 *
 * 2. OPTIMIZED LAYER ACCESS
 *    - &mo 1: Numbers/Nav on left thumb or Tab hold
 *    - &mo 2: Symbols on home row holds (F, J, ;) + right thumb
 *    - &mo 3: Function/System on top corners + dedicated key
 *    - Quick access to all essential functions
 *
 * 3. CONSOLIDATED SYMBOLS
 *    - 3 symbol layers � 1 comprehensive symbol layer
 *    - Most common symbols easily accessible
 *    - Logical grouping: programming symbols, brackets, operators
 *
 * 4. HOME ROW MODS PRESERVED
 *    - All original behaviors maintained (hm, hh, ht, hl, pinky)
 *    - Same tapping terms and timing
 *    - Proven ergonomic benefits retained
 *
 * 5. SMART CONSOLIDATION
 *    - Numbers + Navigation combined (complementary use cases)
 *    - Function + System combined (infrequent access, logical pairing)
 *    - Window Manager shortcuts distributed logically
 *
 * 6. FLEXIBILITY
 *    - 5 reserved layers for future customization (layers 4-8)
 *    - Easy to adjust symbol placement based on usage patterns
 *    - Room to add alternative layouts or specialized layers later
 *
 * ============================================================
 * USAGE TIPS
 * ============================================================
 *
 * COMMON WORKFLOWS:
 *
 * 1. Coding:
 *    - Base layer for typing
 *    - Hold F or J for symbols
 *    - Hold Tab for numbers
 *
 * 2. Navigation (vim-style):
 *    - Hold Tab → use HJKL for arrows (right hand)
 *    - Home/End/PgUp/PgDn on left home row
 *
 * 3. Numpad:
 *    - Hold Tab → right hand numpad
 *    - Natural calculator-style layout
 *
 * 4. System Control:
 *    - Press &mo 3 key (top corners)
 *    - Access F-keys, Bluetooth, RGB
 *
 * 5. Window Management:
 *    - Layer 3 for Cmd+N shortcuts
 *    - Alt+Cmd+F for fullscreen on Layer 3
 *
 * ============================================================
 * CUSTOMIZATION NOTES
 * ============================================================
 *
 * Easy adjustments you might want:
 *
 * 1. Swap number row and numpad priority
 * 2. Adjust symbol positions based on your usage
 * 3. Add more window manager shortcuts to Layer 1
 * 4. Configure combo positions to avoid accidental triggers
 * 5. Fine-tune tapping terms for your typing speed
 *
 * The 4-layer approach provides excellent balance between:
 * - Simplicity (fewer layers to remember)
 * - Functionality (all essential keys accessible)
 * - Ergonomics (home row mods, minimal finger travel)
 * - Performance (quick layer access, logical grouping)
 */
